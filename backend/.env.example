# Environment Variables — CipherShield Auth API
# Copy this file to .env and fill in the values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ciphershield_auth
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname

# ─── JWT Secrets (use strong random strings, min 32 chars) ───────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES=1h

# ─── Frontend Origin (for CORS) ───────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email Setup (for OTP) ────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="CipherShield <noreply@ciphershield.dev>"
