# Environment Variables — CipherShield Auth API

PORT=5001
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/ciphershield_auth
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES=1h

CLIENT_URL=http://localhost:5173

# ─── Email Setup (for Real OTP Verification Emails) ───────────────────────────
# How to send REAL emails to Gmail inboxes:
# 1. Open Google Account Security: https://myaccount.google.com/security
# 2. Turn ON "2-Step Verification"
# 3. Create an App password: https://myaccount.google.com/apppasswords
# 4. Fill in EMAIL_USER and EMAIL_PASS below:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="CipherShield <noreply@ciphershield.dev>"
